# SQLite database path (created automatically)
DATABASE_PATH=db/news.db

# Local GDELT 2.x event CSV directory (tab-separated, no header)
GDELT_DIR=data/raw_gdelt

# Market benchmark ticker (Yahoo Finance symbol)
BENCHMARK_TICKER=SPY

# Yahoo Finance
YF_TIMEOUT_SECONDS=30
YF_MAX_RETRIES=3

# Entity resolution
FUZZY_MIN_SCORE=92
FUZZY_AMBIGUITY_GAP=5
FUZZY_MIN_NAME_LENGTH=6

# Backtest (basis points, 10 = 0.10%)
TRANSACTION_COST_BPS=10
SLIPPAGE_BPS=5
MAX_POSITIONS=10
TRAIN_FRACTION=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
